window.__bombadil__ = window.__bombadil__ || {
	edges_previous: new Uint8Array(65536),
	edges_current: new Uint8Array(65536),
	previous: 0
};
function example(a, b, c) {
	if (a) {
		__bombadil__.edges_current[((1447678055 ^ __bombadil__.previous) >>> 0) % 65536] += 1;
		__bombadil__.previous = 1447678055 >> 1;
		return b;
	} else {
		__bombadil__.edges_current[((1015584228 ^ __bombadil__.previous) >>> 0) % 65536] += 1;
		__bombadil__.previous = 1015584228 >> 1;
		return c;
	}
}
console.log(example(true, 1, 2));

